{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd app && npm install",
  "buildCommand": "cd app && npm run build -- --webpack",
  "outputDirectory": "app/.next",
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/reminders",
      "schedule": "0 14 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "yardtize.vercel.app"
        }
      ],
      "destination": "https://www.yardtize.com/:path",
      "permanent": false
    }
  ]
}
