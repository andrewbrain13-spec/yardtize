# Build-time defaults for the deployed site.
#
# Both values below are PUBLIC BY DESIGN: they are compiled into the JavaScript
# every visitor downloads, so they are not secrets. What protects the database
# is row-level security, which is verified working — an anonymous caller
# reading `profiles`, `listings` or `requests` with this key gets back nothing.
#
# The secret key is deliberately NOT here and never ships to the browser.
#
# Environment Variables set in the Vercel dashboard override this file, so
# adding them there later takes precedence with no code change.

NEXT_PUBLIC_SUPABASE_URL=https://tzqlcdfchamvawqvogxw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_JHhg2TFrYD69lBAhKxRLYQ_EPNYhn7C
