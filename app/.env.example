# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Only needed for direct Postgres connections (migrations).
SUPABASE_DB_PASSWORD=

# Google Maps — Maps JavaScript, Geocoding and Places APIs enabled,
# key restricted to the Vercel + yardtize.com domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
